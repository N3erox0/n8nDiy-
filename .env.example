# 本文件只是示例，真实值由 deploy.sh 生成到 /data/cf-n8n-secrets/system.env，
# 并以 .env 软链接的形式给 docker compose 读取。不要把真实值写进仓库。
POSTGRES_USER=n8n
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=n8n
N8N_ENCRYPTION_KEY=CHANGE_ME
N8N_OWNER_EMAIL=admin@cf.local
N8N_OWNER_PASSWORD=CHANGE_ME
WORKER_TOKEN=CHANGE_ME
# 第三方密钥所在目录（只读挂进 worker）
SECRETS_DIR=/data/cf-n8n-secrets/worker
